#!/bin/sh
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS
export XKL_XMODMAP_DISABLE=1
[ -r "$HOME/.Xresources" ] && xrdb "$HOME/.Xresources"

# Minimize panel/workspaces + launch Chrome once the session is up
(
  sleep 2
  /usr/local/bin/minimize-xfce.sh >>"$HOME/.xfce-minimize.log" 2>&1 || true
  # Wait for X session to be ready, then open Chrome (was missing → never auto-started)
  for _ in $(seq 1 30); do
    if xdpyinfo >/dev/null 2>&1; then
      break
    fi
    sleep 0.3
  done
  if ! pgrep -f "google-chrome|chrome" >/dev/null 2>&1; then
    nohup /usr/local/bin/bot-chrome >>"$HOME/.chrome-autostart.log" 2>&1 &
  fi
) &

# Must stay in foreground so TigerVNC keeps the session alive
if command -v dbus-launch >/dev/null 2>&1; then
  exec dbus-launch --exit-with-session startxfce4
fi
exec startxfce4
