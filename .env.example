# Copy to .env (mode 600). Never commit real values.

# OpenAI-compatible provider key/base URL used by search
# (legacy name MISTER3D_API_KEY is still accepted).
# AUTONOMOUS_LLM_API_KEY=
# AUTONOMOUS_LLM_BASE_URL=
# OPENAI_API_KEY=

# GUI grounding (UI-TARS) — disabled while the URL is empty. Clicks are
# verified by the LLM configured in Settings → LLM (~/.pi/agent/models.json).
# AUTONOMOUS_GROUNDER_URL=
# AUTONOMOUS_GROUNDER_MODEL=ui-tars-1.5-7b
# AUTONOMOUS_GROUNDER_TOKEN=

# Companion build at startup (set 0 to disable).
# AUTONOMOUS_COMPANION_BUILD=1

# Override data directory (default: ./data)
# AUTONOMOUS_HOME=

# Flask session signing key (defaults to data/secret after `autonomous init`).
# Must NOT equal the API Bearer in data/token.
# AUTONOMOUS_SECRET=

# Allow serve without init (throwaway only — SECRET_KEY becomes "dev-insecure").
# AUTONOMOUS_ALLOW_INSECURE=0

# Bind serve on a non-loopback address (requires explicit ack; prefer reverse proxy + TLS).
# AUTONOMOUS_BIND_PUBLIC=0

# Trust X-Forwarded-For for rate limits (only when a reverse proxy overwrites XFF).
# AUTONOMOUS_TRUST_PROXY=0

# Force Secure session cookies (also auto-on when AUTONOMOUS_PUBLIC_URL is https://…).
# AUTONOMOUS_COOKIE_SECURE=0
# AUTONOMOUS_PUBLIC_URL=https://autonomous.example
